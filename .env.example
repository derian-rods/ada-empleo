# GPSAE Configuration Example
# 
# Copy this file to .env (or .env.development / .env.production) and update the values
#
# GPSAE is the external system for request tracking.
# The URL should point to your GPSAE instance's request page.
# 
# Example:
# - For development: https://gpsae-dev.example.com/peticion
# - For production: https://gpsae.example.com/peticion
#
VITE_GPSAE_BASE_URL=https://ws148.juntadeandalucia.es/gp-sae/issues
